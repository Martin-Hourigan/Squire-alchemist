; Engine configuration file.

config_version=5

[application]

config/name="Squire (alchemist)"
config/description="Real-time combat slice: the hero fights on their own; you, the alchemist squire, brew potions from a bag of ingredients and hand them over."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

ScreenshotRecorder="*res://scripts/screenshot_recorder.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
